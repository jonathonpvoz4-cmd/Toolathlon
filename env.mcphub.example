# Copy to .env.mcphub; export into the shell before starting existing scripts.
# Direct mode remains the default if MCP_TOOL_TRANSPORT is absent.
MCP_TOOL_TRANSPORT=hub
MCPHUB_URL=http://192.168.0.22:3003
MCPHUB_CATALOG=toolathlon
# Group key: grant toolathlon MCPs and the public serper resource.
MCPHUB_TOKEN=
# Optional: defaults to MCPHUB_URL + /http/serper/search in Hub mode.
# Full search endpoint, NOT a base URL. Never put the upstream Serper key here.
# SERPER_API_URL=http://192.168.0.22:3003/http/serper/search
# Optional separate Hub key if public Serper belongs to another calling group.
# SERPER_API_KEY=
# Callback host is auto-detected from the route to Hub. Override only if needed.
# MCPHUB_CALLBACK_HOST=192.168.0.22
# Required for run_with_workspace.py: one account workspace for preparation, MCPs and grading.
MCPHUB_TARGET=account-a
# MCPHUB_RUN_ID / MCPHUB_RUN_TOKEN are generated by the wrapper; do not fill them manually.
# Override only to intentionally keep selected shared candidates in task containers.
# Empty means all MCPs use task callbacks; this is not an automatic fallback.
# MCPHUB_SERVERS=rail_12306,fetch,google_map,howtocook,scholarly,yahoo-finance,youtube,youtube-transcript
